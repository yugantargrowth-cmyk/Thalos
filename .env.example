# THALOS Bootstrap Configuration
# This file contains ONLY infrastructure bootstrap settings.
# Provider API keys (Groq, Gemini, Tavily, Resend, etc.) are NEVER stored here.
# They are managed through the Integrations API and stored encrypted in the database.
#
# Copy this to .env (never commit .env to Git) and fill in real values.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (not secret)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-only. Never expose to browser or client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -base64 64
JWT_SECRET=generate-a-long-random-string

# Owner PIN (hashed at startup; not stored in plaintext)
# Example: set OWNER_PIN_HASH to $(node scripts/hash-pin.js YOUR_PIN)
OWNER_PIN_HASH=bcrypt-hash-of-your-pin

# ── Encryption (for credential envelope fallback) ─────────────────────────────
# Master key for AES-256-GCM envelope encryption if Vault is unavailable.
# Generate with: openssl rand -hex 32
# This is an infrastructure bootstrap secret, not a provider API key.
CREDENTIAL_MASTER_KEY=generate-with-openssl-rand-hex-32

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_CONCURRENCY=3

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── SearXNG ──────────────────────────────────────────────────────────────────
# Self-hosted SearXNG base URL (internal network only)
SEARXNG_BASE_URL=http://localhost:8080
# SearXNG server secret (set in searxng/settings.yml)
SEARXNG_SECRET=generate-a-secret-for-searxng

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Never set to 'debug' in production — may log request bodies
