{
  "name": "thalos-backend",
  "version": "1.0.0",
  "description": "THALOS — Agentic AI Business Operating System for Yugantar Growth",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build && node -e \"fs.cpSync('frontend/out', 'public', {recursive: true, force: true})\"",
    "build": "tsc -p tsconfig.build.json --noEmitOnError false",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:security": "vitest run tests/security",
    "test:worker": "vitest run tests/worker",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "openapi:validate": "node scripts/validate-openapi.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.2.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.3.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "rate-limiter-flexible": "^5.0.3",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "winston": "^3.15.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.1",
    "@types/node-forge": "^1.3.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
